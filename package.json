{
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.4.0",
    "prettier": "3.1.1",
    "purgecss": "8.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "JEKYLL_ENV=production bundle exec jekyll build",
    "purge": "purgecss -c purgecss.config.js",
    "check:site": "python3 scripts/check_site.py _site",
    "check": "npm test && npm run build && npm run purge && npm run check:site"
  }
}
