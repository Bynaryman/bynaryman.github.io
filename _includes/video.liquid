{% assign extension = include.path | split: '.' | last %}
{% assign video_key = include.path %}
{% assign first_character = video_key | slice: 0, 1 %}
{% if first_character == '/' %}{% assign video_key = video_key | remove_first: '/' %}{% endif %}
{% assign poster = include.poster | default: site.data.video_posters[video_key] %}
<figure>
  {% if extension == 'mp4' or extension == 'webm' or extension == 'ogg' %}
    <video
      src="{{ include.path | relative_url }}"
      class="{{ include.class }}"
      controls
      playsinline
      preload="none"
      {% if poster %}
        poster="{{ poster | relative_url }}"
      {% endif %}
      {% if include.loop %}
        loop
      {% endif %}
      {% if include.muted %}
        muted
      {% endif %}
      aria-label="{{ include.title | default: include.alt | default: 'Video player' | escape }}"
    >
      <a href="{{ include.path | relative_url }}">Download video</a>
    </video>
  {% else %}
    <iframe
      src="{{ include.path }}"
      class="{{ include.class }}"
      loading="lazy"
      style="width:100%;aspect-ratio:16/9;border:0"
      title="{{ include.title | default: include.alt | default: 'Embedded video' | escape }}"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  {% endif %}
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption | markdownify }}</figcaption>
  {% endif %}
</figure>
