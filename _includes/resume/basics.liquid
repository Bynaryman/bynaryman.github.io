{% assign basics = items %}
<p>{{ basics.label }} · Université de Rennes / ISTIC · IRISA / Inria Taran</p>
<p>{{ basics.summary }}</p>
<p>
  <a href="mailto:{{ site.email | encode_email }}">{{ basics.email }}</a> ·
  <a href="tel:{{ basics.phone | replace: '[seven]', '7' | remove: ' ' }}">{{ basics.phone }}</a>
</p>
<p>
  {% for profile in basics.profiles -%}
    <a href="{{ profile.url }}">{{ profile.network }}</a>
    {%- unless forloop.last %} · {% endunless -%}
  {%- endfor %}
</p>
