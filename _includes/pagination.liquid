{% if paginator.total_pages > 1 %}
  <nav class="blog-pagination" aria-label="Blog page navigation">
    <ul>
      <li>
        {% if paginator.previous_page %}
          <a class="blog-pagination__link" href="{{ paginator.previous_page_path | relative_url }}" rel="prev"><span aria-hidden="true">←</span> Newer</a>
        {% else %}
          <span class="blog-pagination__link" aria-disabled="true"><span aria-hidden="true">←</span> Newer</span>
        {% endif %}
      </li>
      {% for trail in paginator.page_trail %}
        <li>
          {% if trail.num == paginator.page %}
            <span class="blog-pagination__link" aria-current="page" aria-label="Page {{ trail.num }}">{{ trail.num }}</span>
          {% else %}
            <a class="blog-pagination__link" href="{{ trail.path | relative_url }}" aria-label="Page {{ trail.num }}">{{ trail.num }}</a>
          {% endif %}
        </li>
      {% endfor %}
      <li>
        {% if paginator.next_page %}
          <a class="blog-pagination__link" href="{{ paginator.next_page_path | relative_url }}" rel="next">Older <span aria-hidden="true">→</span></a>
        {% else %}
          <span class="blog-pagination__link" aria-disabled="true">Older <span aria-hidden="true">→</span></span>
        {% endif %}
      </li>
    </ul>
  </nav>
{% endif %}
