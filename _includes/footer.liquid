<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom mt-4{% endif %}" role="contentinfo">
  <div class="container footer-content">
    <div class="footer-copyright">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Site built: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
    {% include destroy_website.liquid %}
  </div>
</footer>
