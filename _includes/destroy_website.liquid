{% comment %}Sprite Fusion's official badge URL, styled locally without a remote image or script.{% endcomment %}
<a
  class="site-action destroy-website"
  href="https://destroy.spritefusion.com/?from=badge&amp;url={{ page.url | absolute_url | url_encode }}"
  target="_blank"
  rel="noopener noreferrer"
  title="Play Destroy Any Website by Sprite Fusion (opens in a new tab)"
>
  <i class="fa-solid fa-bomb" aria-hidden="true"></i>
  <span>Destroy this website</span>
  <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
  <span class="sr-only">with Sprite Fusion (opens in a new tab)</span>
</a>
