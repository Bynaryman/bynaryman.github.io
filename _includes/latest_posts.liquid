{% if site.posts.size > 0 %}
  {% assign latest_limit = site.latest_posts.limit | default: site.posts.size %}
  <ul class="post-cards post-cards--latest">
    {% for post in site.posts limit: latest_limit %}
      <li>{% include post_card.liquid post=post compact=true heading='h3' %}</li>
    {% endfor %}
  </ul>
  <p class="all-posts-link"><a href="{{ '/blog/' | relative_url }}">All posts <span aria-hidden="true">→</span></a></p>
{% else %}
  <p>No posts so far.</p>
{% endif %}
