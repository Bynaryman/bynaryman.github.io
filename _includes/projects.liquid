<div class="col mb-4">
  <article class="card h-100">
    {% if project.img -%}
      {%- include figure.liquid path=project.img sizes="(min-width: 768px) 360px, 90vw" alt=project.title class="card-img-top" -%}
    {%- endif %}
    <div class="card-body">
      <h3 class="card-title">
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
      </h3>
      <p class="card-text">{{ project.description }}</p>
      {% if project.github -%}
        <a href="{{ project.github }}" class="project-source"
          ><i class="fa-brands fa-github" aria-hidden="true"></i> Source code<span class="sr-only"> for {{ project.title }}</span></a
        >
      {%- endif %}
    </div>
  </article>
</div>
