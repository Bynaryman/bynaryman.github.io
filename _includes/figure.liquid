{% assign image_key = include.path %}
{% assign first_character = image_key | slice: 0, 1 %}
{% if first_character == '/' %}{% assign image_key = image_key | remove_first: '/' %}{% endif %}
{% assign optimized = site.data.responsive_images[image_key] %}
<figure
  {% if include.slot %}
    slot="{{ include.slot }}"
  {% endif %}
>
  <img
    src="{% if optimized %}{{ optimized.src | relative_url }}{% else %}{{ include.path | relative_url }}{% endif %}"
    {% if optimized %}
      srcset="{% for variant in optimized.variants %}{{ variant.path | relative_url }} {{ variant.width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
      sizes="{{ include.sizes | default: '(min-width: 1200px) 1100px, 90vw' }}"
      width="{{ optimized.width }}" height="{{ optimized.height }}"
    {% endif %}
    class="{{ include.class }}"
    alt="{{ include.alt | default: '' | escape }}"
    {% if include.title %}
      title="{{ include.title | escape }}"
    {% endif %}
    {% if include.zoomable %}
      data-zoomable data-zoom-src="{{ include.path | relative_url }}"
    {% endif %}
    loading="{{ include.loading | default: 'lazy' }}"
    decoding="async"
    {% if include.loading == 'eager' %}
      fetchpriority="high"
    {% endif %}
  >
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption | markdownify }}</figcaption>
  {% endif %}
</figure>
