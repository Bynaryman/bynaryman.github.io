<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <title>
      {{ page.title | escape }}
      — Bitmosh
    </title>
    <!-- Standalone review evidence: no navigation, analytics or remote dependencies. -->
    <style>
      :root {
        color-scheme: light dark;
        --paper: #faf6ed;
        --ink: #27283c;
        --muted: #535569;
        --accent: #3535a5;
        --line: #d6d3de;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font:
          1rem/1.65 system-ui,
          sans-serif;
      }
      main {
        max-width: 58rem;
        margin: auto;
        padding: 2rem 1.25rem 3rem;
      }
      .brand {
        color: var(--accent);
        font:
          700 0.9rem/1.5 ui-monospace,
          monospace;
        letter-spacing: 0.06em;
      }
      h1 {
        font-size: clamp(1.6rem, 5vw, 2.3rem);
        line-height: 1.25;
      }
      h2 {
        font-size: 1.15rem;
        margin-top: 2rem;
      }
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
      }
      .recording {
        display: grid;
        grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
        margin-top: 1.5rem;
      }
      video {
        display: block;
        width: 100%;
        max-height: 80vh;
        background: #111;
        border: 1px solid var(--line);
      }
      a {
        color: var(--accent);
        text-underline-offset: 0.2em;
        overflow-wrap: anywhere;
      }
      a:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
      }
      li {
        margin: 0.5rem 0;
      }
      code {
        font-size: 0.85em;
        overflow-wrap: anywhere;
      }
      footer {
        margin-top: 2rem;
        border-top: 1px solid var(--line);
        padding-top: 1rem;
      }
      @media (max-width: 640px) {
        .recording {
          grid-template-columns: minmax(0, 1fr);
        }
        video {
          max-width: 24rem;
          margin-inline: auto;
        }
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #20212d;
          --ink: #efedf5;
          --muted: #bebccc;
          --accent: #bcb5ff;
          --line: #494758;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <p class="brand">BITMOSH / BINARYMAN</p>
        <h1>{{ page.title }}</h1>
        <p>Google Play foreground-service demonstration</p>
        <p class="meta">
          {{ page.device -}}
          <br>
          Bitmosh 0.7.1 (13) · <time datetime="2026-09-21">21 September 2026</time>
        </p>
      </header>
      <div class="recording">
        <div>
          <video controls playsinline preload="metadata" aria-label="{{ page.title | escape }} screen recording">
            <source src="{{ page.video | relative_url }}" type="video/mp4">
            Your browser cannot play this video. Use the MP4 link below.
          </video>
          <p><a href="{{ page.video | relative_url }}">Open the MP4 directly</a></p>
        </div>
        <article>
          {{ content }}
        </article>
      </div>
      <footer class="meta">
        App: <code>io.binaryman.arts.bitmosh</code> · Louis Ledoux / Binaryman<br>
        Real screen recording, original bundled demo footage, no microphone audio. Playback is at the recorded speed.
      </footer>
    </main>
  </body>
</html>
