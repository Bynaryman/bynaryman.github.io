---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title cv-heading">
      <span>{{ page.title }}</span>
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url}}"
          target="_blank"
          rel="noopener noreferrer"
          class="cv-download"
          aria-label="Download CV as PDF"
          ><i class="fa-solid fa-file-pdf"></i
        ></a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for section in site.jsonresume %}
        {% assign items = site.data.resume[section] %}
        {% if items == null or items.size == 0 %}
          {% continue %}
        {% endif %}
        <a class="anchor" id="{{ section }}"></a>
        <div class="card mt-3 p-3">
          <h2 class="card-title font-weight-medium">
            {% case section %}
              {% when 'basics' -%}
                Profile
              {% when 'work' -%}
                Experience
              {% when 'teaching' -%}
                Teaching
              {% when 'education' -%}
                Education
              {% when 'journals' -%}
                Journal articles
              {% when 'conference_papers' -%}
                Conference papers
              {% when 'tutorials' -%}
                Tutorials, workshops, and demos
              {% when 'contributions' -%}
                Contributions to publications
              {% when 'posters' -%}
                Posters
              {% when 'invited_talks' -%}
                Talks and seminars
              {% when 'academic_reviewing' -%}
                Peer reviewing
              {% when 'conference_organization' -%}
                Conference organisation
              {% when 'academic_summer_schools' -%}
                Summer schools and workshops
              {% when 'internship_mentoring' -%}
                Mentoring
              {% when 'projects' -%}
                Software and hardware
              {% when 'skills' -%}
                Skills
              {% when 'languages' -%}
                Languages
              {% else -%}
                {{- section | replace: '_', ' ' | capitalize }}
            {% endcase %}
          </h2>
          <div>
            {% case section %}
              {% when 'basics' %}
                {% include resume/basics.liquid %}
              {% when 'education' %}
                {% include resume/education.liquid %}
              {% when 'work' %}
                {% include resume/work.liquid %}
              {% when 'teaching' %}
                {% include resume/work.liquid %}
              {% when 'projects' %}
                {% include resume/projects.liquid %}
              {% when 'skills' %}
                {% include resume/skills.liquid %}
              {% when 'languages' %}
                {% include resume/languages.liquid %}
              {% when 'journals' %}
                {% include resume/publications.liquid %}
              {% when 'conference_papers' %}
                {% include resume/publications.liquid %}
              {% when 'tutorials' %}
                {% include resume/publications.liquid %}
              {% when 'contributions' %}
                {% include resume/publications.liquid %}
              {% when 'posters' %}
                {% include resume/publications.liquid %}
              {% when 'invited_talks' %}
                {% include resume/publications.liquid %}
              {% when 'academic_reviewing' %}
                {% include resume/publications.liquid %}
              {% when 'conference_organization' %}
                {% include resume/publications.liquid %}
              {% when 'academic_summer_schools' %}
                {% include resume/publications.liquid %}
              {% when 'internship_mentoring' %}
                {% include resume/publications.liquid %}
              {% when 'volunteer' %}
                {% include resume/volunteer.liquid %}
              {% when 'awards' %}
                {% include resume/awards.liquid %}
              {% when 'certificates' %}
                {% include resume/certificates.liquid %}
              {% when 'interests' %}
                {% include resume/interests.liquid %}
              {% when 'references' %}
                {% include resume/references.liquid %}
            {% endcase %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
