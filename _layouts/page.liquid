---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.collection == 'projects' and page.github %}
      <nav class="project-docs" aria-label="Project documentation">
        <a href="{{ page.github }}"><i class="fa-brands fa-github" aria-hidden="true"></i> Source code</a>
        <a href="{{ page.github }}#readme">Repository README <span aria-hidden="true">↗</span></a>
      </nav>
    {% endif %}
  </header>

  <article class="page-content">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
